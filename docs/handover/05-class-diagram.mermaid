%% 05 · 增量类图（从 05-增量架构设计与实施任务列表.md §4 抽取）
%% 说明：本图是「增量层」——02 §5.1 统一类图原样保留在 02，此处只画本轮新增/扩展的类型与关系。
%% 图例：<<new>> = 本轮新增；<<ext>> = 02 已有类型的本轮扩展；<<reuse>> = 02 已有、原样复用。
%% 内容以 05 主文档 §4 为准；本件仅便于下游工具复用，不写任何实现代码。

classDiagram
    direction TB

    class Config {
        <<ext>>
        +bind: String
        +dev: bool
        +data_dir: PathBuf
        +protocol_version: &'static str
        +rate_window_ms: i64
        +rate_max_attempts: u32
        +lockout_threshold: u32
        +lockout_base_ms: i64
        +lockout_max_backoff_ms: i64
        +lockout_max_ms: i64
        +master_exempt: bool
        +from_env() Result~Config, ConfigError~
        +db_path() PathBuf
        +throttle() ThrottleConfig
    }

    class ThrottleConfig {
        <<new>>
        <<7 项阈值只读快照, Clone + Send + Sync>>
    }

    class SubjectKey {
        <<new>>
        +kind: SubjectKind
        +subject_id: String
        +source_id: String
        +stable_key() String
    }

    class SubjectKind {
        <<new>>
        <<enumeration>>
        Master
        Device
        Pairing
        Anonymous
    }

    class AuthContext {
        <<ext>>
        +principal: Principal
        +credential: Option~Credential~
        +scope: Option~Scope~
        +trace_id: String
        +subject_key: SubjectKey
        +is_master() bool
    }

    class Principal {
        <<reuse>>
        <<enumeration>>
        Master
        Device
    }

    class RateLimiter {
        <<new>>
        <<trait, Send + Sync>>
        +check(key, now_ms, cfg) Result~RateDecision, ThrottleError~
    }

    class RateDecision {
        <<new>>
        <<enumeration>>
        Allow
        Throttle
    }

    class Lockout {
        <<new>>
        <<trait, Send + Sync>>
        +state(key, now_ms) Result~LockDecision, ThrottleError~
        +on_failure(key, now_ms, cfg) Result~LockDecision, ThrottleError~
        +on_success(key, now_ms) Result~(), ThrottleError~
    }

    class LockDecision {
        <<new>>
        <<enumeration>>
        Open
        Locked
    }

    class require_auth {
        <<ext>>
        +EXEMPT_PATHS: const &'static [&str]
        +M_ONLY_PATHS: const &'static [&str]
        +require_auth(State~AppState~, Request, Next) Result~Response, StatusCode~
        +auth_layer(AppState) impl Layer + Clone
    }

    class StateCache {
        <<ext>>
        <<trait, Send + Sync>>
        +write_through(repo, entity) Result~(), StateError~
        +read(id) Option~T~
        +restore(pool) Result~(), StateError~
    }

    class AppState {
        <<ext>>
        <<Clone + Send + Sync + 'static>>
        +db: Arc~DbPool~
        +config: Arc~Config~
        +cache: Arc~StateCache~
    }

    class DbPool {
        <<reuse>>
        <<唯一 Connection::open 点>>
        +open(cfg) Result~DbPool, DbError~
        +conn() Result~Connection, DbError~
        +migrate() Result~(), DbError~
        +with_tx(f) Result~T, DbError~
    }

    class Repository~T~ {
        <<reuse>>
        <<trait>>
        +get(id) Result~Option~T~, DbError~
        +upsert(e) Result~(), DbError~
        +list(f) Result~Vec~T~, DbError~
    }

    class AuthThrottleState {
        <<new>>
        <<第 13 表实体>>
        +subject_key: String
        +subject_kind: String
        +window_start_ms: i64
        +window_count: i64
        +failure_count: i64
        +backoff_exp: i64
        +last_attempt_ms: i64
        +created_ms: i64
        +updated_ms: i64
        +locked_until_ms: Option~i64~
    }

    class PathGuard {
        <<reuse>>
        <<trait, Send + Sync>>
        +normalize_and_check(raw) Result~PathBuf, PathError~
    }

    class AuditWriter {
        <<reuse>>
        <<trait, Send + Sync · 唯一审计出口>>
        +write(e) Result~(), AuditError~
        +verify_chain() ChainResult
        +tail(n) Vec~AuditEvent~
        +query(f) Vec~AuditEvent~
    }

    class AuditAction {
        <<ext>>
        <<enum · 02 §8.2 常量表 + 3 新事件>>
        auth
        auth_deny
        auth_throttled
        auth_locked
        auth_unlocked
        scope_deny
        +as_str() &'static str
    }

    Config ..> ThrottleConfig : 产出
    Config *-- AppState : Arc~Config~
    ThrottleConfig <.. RateLimiter : 读 cfg
    ThrottleConfig <.. Lockout : 读 cfg

    SubjectKey *-- SubjectKind
    AuthContext *-- SubjectKey : 增量字段
    AuthContext *-- Principal
    AuthContext ..> AuthThrottleState : stable_key() 定位行

    require_auth ..> AuthContext : 注入 req.extensions
    require_auth ..> RateLimiter : ③ check
    require_auth ..> Lockout : ④ state / ⑥ on_failure / ⑦ on_success
    require_auth ..> AuditWriter : 401/429 写 auth_deny/throttled/locked
    require_auth ..> PathGuard : FC4 解析失败=拒绝
    require_auth ..> Config : EXEMPT_PATHS / M_ONLY_PATHS

    RateLimiter ..> RateDecision : 返回
    Lockout ..> LockDecision : 返回
    RateLimiter ..> Repository~AuthThrottleState~ : 经写穿落库
    Lockout ..> Repository~AuthThrottleState~ : 经写穿落库
    RateLimiter ..> StateCache : 先落库再更新缓存
    Lockout ..> StateCache : 先落库再更新缓存

    StateCache ..> DbPool : restore() / with_tx()
    Repository~AuthThrottleState~ ..> DbPool : conn()/with_tx()（唯一 open）
    Repository~AuthThrottleState~ ..> AuthThrottleState : upsert/get/list
    AppState *-- DbPool
    AppState *-- StateCache

    AuditWriter ..> AuditAction : as_str() 取常量
    AuditWriter ..> DbPool : SQLite 双写
    DbPool ..> AuthThrottleState : migrate() 建第 13 表
