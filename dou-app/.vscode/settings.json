{
  // 豆 Dou · Tauri 2 (Rust) + Vue 3 工作区设置
  // 工具链由 ../rust-toolchain.toml 固定为 stable-x86_64-pc-windows-msvc
  // 不写死 CARGO_NET_OFFLINE：新机 cargo 缓存为空时强制离线会让 rust-analyzer
  // 直接报错。需要离线时在项目根目录跑 `cargo fetch` 预热后再手动设环境变量。
  "rust-analyzer.linkedProjects": ["./src-tauri/Cargo.toml"],
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": [],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "[typescript]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/dist": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/Cargo.lock": true
  },
  "terminal.integrated.env.windows": {},
  "typescript.tsdk": "node_modules/typescript/lib"
}
